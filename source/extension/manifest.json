{
  "manifest_version": 3,
  "name": "KUBLA KHAN",
  "version": "2.2.0",
  "minimum_chrome_version": "120",
  "description": "Two coordinated Khan classroom tabs: queued 2x video playback and automatic supported algebra entry/check/next with explicit pause diagnostics.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://classroom.khanacademy.org/*",
    "https://www.khanacademy.org/*",
    "https://www.youtube.com/embed/*",
    "https://www.youtube-nocookie.com/embed/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "KUBLA KHAN",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://classroom.khanacademy.org/*",
        "https://www.khanacademy.org/*",
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "adapter.js",
        "runner-content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ]
}
